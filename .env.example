# Copie para .env e preencha. Nunca commite o .env.
HF_TOKEN=                 # token com permissão de escrita: https://huggingface.co/settings/tokens
HF_USERNAME=              # seu usuário no Hugging Face

# LLM usado na pré-rotulagem e no zero-shot (configurável)
LLM_PROVIDER=anthropic    # anthropic | openai_compatible
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_BASE_URL=             # só para provedores compatíveis com OpenAI
